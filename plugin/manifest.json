{
  "schemaVersion": 1,
  "id": "local.pi-perch",
  "name": "Perch Bridge",
  "version": "0.3.1",
  "description": "Use Perch models in PI with a self-managed official runtime and browser sign-in. No global Perch CLI, Node or npm installation required.",
  "author": "pi-perch",
  "license": "MIT",
  "main": "main.js",
  "categories": [
    "productivity"
  ],
  "permissions": [
    "ui.panel",
    "background.service",
    "net.fetch",
    "provider.register",
    "models.list"
  ],
  "net": {
    "domains": [
      "app.perchai.app",
      "*.supabase.co",
      "registry.npmjs.org"
    ]
  },
  "engines": {
    "piDesktop": ">=0.21.0"
  },
  "ui": {
    "panel": "renderer/index.html",
    "title": {
      "en": "Perch Bridge",
      "zh-CN": "Perch 桥接"
    },
    "width": 900,
    "height": 860
  },
  "activationEvents": [
    "onStartup"
  ],
  "contributes": {
    "services": [
      {
        "id": "perch-provider-host",
        "label": "Perch provider host"
      }
    ],
    "settings": [
      {
        "key": "enabled",
        "type": "boolean",
        "title": "Enable Perch Bridge",
        "default": true,
        "scope": "plugin"
      },
      {
        "key": "preferredPort",
        "type": "number",
        "title": "Loopback port (1025-65535)",
        "description": "Local port used by PI. If occupied, free the port or choose a different one and reload the plugin.",
        "default": 41891,
        "scope": "plugin"
      },
      {
        "key": "refreshSeconds",
        "type": "number",
        "title": "Model list refresh interval (seconds)",
        "description": "How often the plugin re-reads the Perch catalog. Minimum 60.",
        "default": 600,
        "scope": "plugin"
      }
    ],
    "providers": [
      {
        "id": "perch",
        "name": "Perch",
        "baseUrl": "http://127.0.0.1:41891/v1",
        "apiStyle": "chat_completions",
        "authKind": "none",
